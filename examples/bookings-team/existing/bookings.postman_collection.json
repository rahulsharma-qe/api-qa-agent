{
  "info": {
    "name": "Bookings smoke",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "TC030 Create and read a booking",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passenger_name\": \"Meera {{$randomInt}}\",\n  \"email\": \"meera.{{$guid}}@testdata.example\",\n  \"amount\": 120\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"pnr\", jsonData.pnr);",
                  "pm.expect(jsonData.status).to.eql(\"active\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Read",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{pnr}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{pnr}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ok\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.amount).to.eql(120);",
                  "pm.expect(body.email).to.include(\"@testdata.example\");",
                  "pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "pm.expect(body.passenger_name).to.match(/Meera/);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health-check",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health-check"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"up\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().status).to.eql(\"ok\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
