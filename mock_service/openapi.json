  "components": {
    "schemas": {
      "Booking": {
        "properties": {
          "pnr": {
            "type": "string",
            "title": "Pnr"
          },
          "passenger_name": {
            "type": "string",
            "title": "Passenger Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "cancelled"
            ],
            "title": "Status"
          },
          "booked_at": {
            "type": "string",
            "format": "date-time",
            "title": "Booked At"
          },
          "cancelled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancelled At"
          }
        },
        "type": "object",
        "required": [
          "pnr",
          "passenger_name",
          "email",
          "amount",
          "status",
          "booked_at"
        ],
        "title": "Booking"
      },
      "BookingList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Booking"
            },
            "type": "array",
            "title": "Items"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "count"
        ],
        "title": "BookingList"
      },
      "BookingUpdate": {
        "properties": {
          "passenger_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Passenger Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "passenger_name",
          "email"
        ],
        "title": "BookingUpdate"
      },
      "CancelRequest": {
        "properties": {
          "cancelled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancelled At",
            "description": "Defaults to now"
          }
        },
        "type": "object",
        "title": "CancelRequest"
      },
      "CancelResult": {
        "properties": {
          "pnr": {
            "type": "string",
            "title": "Pnr"
          },
          "refund_allowed": {
            "type": "boolean",
            "title": "Refund Allowed"
          },
          "refund_amount": {
            "type": "number",
            "title": "Refund Amount"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "pnr",
          "refund_allowed",
          "refund_amount",
          "reason"
        ],
        "title": "CancelResult"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "The one error shape (mock_service/errors.py), so the OpenAPI description shows it."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "title": "Health"
      },
      "NewBooking": {
        "properties": {
          "passenger_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Passenger Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "amount": {
            "type": "number",
            "minimum": 0.0,
            "title": "Amount"
          },
          "booked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Booked At",
            "description": "Defaults to now; set it to test time boundaries"
          }
        },
        "type": "object",
        "required": [
          "passenger_name",
          "email",
          "amount"
        ],
        "title": "NewBooking"
      },
      "RefundStatus": {
        "properties": {
          "pnr": {
            "type": "string",
            "title": "Pnr"
          },
          "refund_status": {
            "type": "string",
            "enum": [
              "refunded",
              "no_refund",
              "not_cancelled"
            ],
            "title": "Refund Status"
          },
          "refund_amount": {
            "type": "number",
            "title": "Refund Amount"
          }
        },
        "type": "object",
        "required": [
          "pnr",
          "refund_status",
          "refund_amount"
        ],
        "title": "RefundStatus"
      },
      "TokenRequest": {
        "properties": {
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "client_secret": {
            "type": "string",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "client_secret"
        ],
        "title": "TokenRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "default": 3600
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenResponse"
      }
    }
  }
}
