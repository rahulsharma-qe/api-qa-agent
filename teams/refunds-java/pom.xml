<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- refunds-java's API tests, generated by qa-agent on restassured-api-framework. -->
  <groupId>team.refundsjava</groupId>
  <artifactId>refunds-java-api-tests</artifactId>
  <version>0.1.0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Until the framework is published, install it once: ./mvnw install in frameworks/restassured_api -->
    <framework.version>0.1.0</framework.version>
    <!-- mvn test -Dgroups=smoke -->
    <groups></groups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.rahulsharma-qe</groupId>
      <artifactId>restassured-api-framework</artifactId>
      <version>${framework.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- A library inside REST Assured's stack logs through SLF4J; this keeps it quiet instead of warning
           that no logger is set. Your own logging replaces it. -->
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>1.7.36</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <groups>${groups}</groups>
          <properties>
            <property>
              <!-- Retry (with -Dretry=1), the whole chain on a failure, evidence (with -Devidence=folder) -->
              <name>listener</name>
              <value>apiqa.framework.testng.RetryTransformer,apiqa.framework.testng.ApiStepsListener</value>
            </property>
          </properties>
          <systemPropertyVariables>
            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
