# The API model. Replace it: qa-agent import api <your openapi.json> (or a .curl file).
services:
  {{ service }}:
    operations:
      - method: POST
        path: /bookings
        summary: Create a booking
        body_required: [passenger_name, email, amount]
        responses: [201, 401, 422]
      - method: GET
        path: /bookings/{pnr}
        summary: Read a booking
        responses: [200, 401, 404]
      - method: GET
        path: /health-check
        responses: [200]
        not_tested: env_check calls it before every run
