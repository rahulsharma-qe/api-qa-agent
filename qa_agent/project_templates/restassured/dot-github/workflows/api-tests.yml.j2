# The team's API tests on every change: environment ready, generated tests up to date, tests, trace.
name: API tests

on:
  push:
  pull_request:

jobs:
  tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven
      - name: Install qa-agent and env_check; install the framework (until it is published)
        run: |
          pip install "api-qa-agent @ git+https://github.com/rahulsharma-qe/api-qa-agent.git"
          git clone --depth 1 https://github.com/rahulsharma-qe/api-qa-agent.git "$RUNNER_TEMP/platform"
          (cd "$RUNNER_TEMP/platform/frameworks/restassured_api" && ./mvnw -q -B install -DskipTests)
      - name: Start the reference API (your own environment replaces this step)
        run: python -m mock_service &
      - name: Is the environment ready? (exit 3 if not)
        run: python -m env_check --env mock
      - name: The generated tests match the approved cases
        run: qa-agent generate && git diff --exit-code src/test/java/generated
      - name: Tests
        run: ./mvnw -B test
      - name: Trace (fails if an approved case has no test)
        if: always()
        run: qa-agent trace --results target/surefire-reports --check
